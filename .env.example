APP_ENV=local
PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5500/bakehouse?sslmode=disable
REDIS_URL=redis://localhost:6390/0

# Two isolated auth realms — these MUST differ, and the server refuses to
# start with either of these dev values when APP_ENV is not "local".
JWT_ISSUER=emzo-bakehouse
CUSTOMER_JWT_SECRET=dev-customer-secret-change-me
STAFF_JWT_SECRET=dev-staff-secret-change-me
CUSTOMER_ACCESS_TTL=1h
CUSTOMER_REFRESH_TTL=720h
STAFF_ACCESS_TTL=8h
STAFF_REFRESH_TTL=168h

# Stripe takes every card payment: storefront checkout, POS payment links
# and refunds. Without STRIPE_SECRET_KEY orders use a no-op processor.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint in the Stripe dashboard (whsec_...), for
# POST /v1/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=


POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=emzo-bakehouse-media
R2_PUBLIC_HOST=

SENTRY_DSN=

GOOGLE_MAPS_API_KEY=

# Comma-separated. May not be "*" outside local — responses carry credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Feature flags: any FEATURE_* variable becomes a flag named after the
# suffix, lowercased. FEATURE_KDS_LIVE=true enables flags.On("kds_live").
# Read once at startup; unset means off.
# FEATURE_KDS_LIVE=false

# --- Cloudflare Images ---------------------------------------------------
# Admin image uploads. All three are required together; with any one missing
# the server refuses uploads rather than producing delivery URLs that 404.
#
# CLOUDFLARE_ACCOUNT_ID   Dashboard -> Images -> the account id (32 hex chars)
# CLOUDFLARE_IMAGES_TOKEN An API token with the "Cloudflare Images: Edit"
#                         permission. Server-side only — never sent to a browser.
# CLOUDFLARE_IMAGES_HASH  The account hash that appears in delivery URLs:
#                         https://imagedelivery.net/<HASH>/<image-id>/<variant>
#                         Not the same string as the account id.
# Leave the three CLOUDFLARE_ values blank to store images on this server's own
# disk instead — no account needed. Local storage does not resize and does not
# work across multiple instances, so it suits development and a single server.
#
# MEDIA_LOCAL_DIR  where the files live, relative to the working directory
# PUBLIC_BASE_URL  the origin a *browser* reaches this API on. Behind a tunnel
#                  or proxy this differs from the listen address, and delivery
#                  URLs built from the wrong one point nowhere.
MEDIA_LOCAL_DIR=storage/images
PUBLIC_BASE_URL=http://localhost:8080

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_IMAGES_HASH=

# ==========================
# Storefront origin
# ==========================
# STOREFRONT_BASE_URL  where the customer storefront is served. Stripe's hosted
#                      Checkout returns the customer here after
#                      they pay, and the return URL is built from this on the
#                      server — never taken from the request, which would make
#                      it an open redirect.
STOREFRONT_BASE_URL=http://localhost:3000
# EMAIL_LOGO_URL     where the white wordmark in email headers is loaded from.
#                    Defaults to <PUBLIC_BASE_URL>/email/logo-white.png, which
#                    the API serves from pkg/email/assets/logo-white.png.
EMAIL_LOGO_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Email -------------------------------------------------------------------
# SendGrid is preferred over SMTP: its HTTP API works on hosts that block
# outbound port 587, and it explains its refusals in words rather than a bare
# status code. Leave SENDGRID_API_KEY blank to fall back to SMTP, and leave
# both blank to have mail written to the log instead of sent.
#
# MAIL_FROM takes "Name <address>" or a bare address. The *address* must be a
# verified sender on the SendGrid account; the display name is free text, which
# is why this reads "Baked Bouquet" over a verified EMZO mailbox.
SENDGRID_API_KEY=
MAIL_FROM="emzo Bakehouse <orders@example.com>"

# Unlocks /v1/platform (business registration, emzo team only). Generate a
# long random value; empty keeps the platform API closed.
PLATFORM_API_KEY=
